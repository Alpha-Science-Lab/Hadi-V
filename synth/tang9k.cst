#=========================================================
# Tang Nano 9K
# GW1NR-LV9QN88PC6/I5
#=========================================================

#---------------------------------------------------------
# 27 MHz Clock
#---------------------------------------------------------
IO_LOC  "clk_27mhz" 52;
IO_PORT "clk_27mhz" IO_TYPE=LVCMOS18;

#---------------------------------------------------------
# Buttons (Active-Low)
# buttons_async[0] -> S1 (Pin 4)
# buttons_async[1] -> S2 (Pin 3)
#---------------------------------------------------------
IO_LOC  "buttons_async[0]" 4;
IO_PORT "buttons_async[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC  "buttons_async[1]" 3;
IO_PORT "buttons_async[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP;

#---------------------------------------------------------
# LEDs (Active-Low)
#---------------------------------------------------------
IO_LOC  "leds[0]" 10;
IO_PORT "leds[0]" IO_TYPE=LVCMOS18;

IO_LOC  "leds[1]" 11;
IO_PORT "leds[1]" IO_TYPE=LVCMOS18;

IO_LOC  "leds[2]" 13;
IO_PORT "leds[2]" IO_TYPE=LVCMOS18;

IO_LOC  "leds[3]" 14;
IO_PORT "leds[3]" IO_TYPE=LVCMOS18;

IO_LOC  "leds[4]" 15;
IO_PORT "leds[4]" IO_TYPE=LVCMOS18;

IO_LOC  "leds[5]" 16;
IO_PORT "leds[5]" IO_TYPE=LVCMOS18;

#---------------------------------------------------------
# Onboard USB-UART (BL702)
#---------------------------------------------------------
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;

IO_LOC  "uart_rx_async" 18;
IO_PORT "uart_rx_async" IO_TYPE=LVCMOS33;

